# Copy to .env. Never commit the completed .env or service-account key.
# Firebase: local firebase_key.json is detected automatically.
# Render: paste the existing base64-encoded service account into this variable.
FIREBASE_KEY_JSON=
# Alternative: absolute or project-relative service-account file path.
# GOOGLE_APPLICATION_CREDENTIALS=firebase_key.json

GEMINI_API_KEY=
# These are configurable because access and quota depend on your AI project.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional email delivery. Leave blank to complete surveys without sending email.
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Native Android apps are not subject to browser CORS.
# For a web client, replace * with its exact allowed origin(s), comma separated.
CORS_ORIGINS=*

# Browser admin login uses the public Firebase API key from the Android config.
# Override only if that key is restricted to Android applications.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
